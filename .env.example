# Copy to .env for docker compose. Never commit .env.
# Anthropic API key for the chat. Without it, the chat runs in offline mode
# (extractive answers from the edition, still verified).
CHAT_PROVIDER=openai_compatible  # Kimi. Use "anthropic" with ANTHROPIC_API_KEY and a Claude model instead.
CHAT_BASE_URL=https://api.moonshot.ai/v1
CHAT_API_KEY=
CHAT_MODEL=kimi-k3
CHAT_MAX_TOKENS=4000             # defaults to 4000 for openai_compatible, 1200 for anthropic
ANTHROPIC_API_KEY=
# Editorial panel at /admin (HTTP Basic). Without a password the panel is disabled.
ADMIN_USER=editor
ADMIN_PASSWORD=
CHAT_RETENTION_DAYS=30
CHAT_RATE_PER_IP_PER_HOUR=30
CHAT_DAILY_BUDGET_CENTS=2000
# Set these to your plan's prices; used only for the daily budget guard.
CHAT_PRICE_IN_CENTS_PER_MTOK=300
CHAT_PRICE_OUT_CENTS_PER_MTOK=1500
